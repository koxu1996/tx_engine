{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build docs",
      "type": "shell",
      "command": "cargo doc --no-deps"
    },
    {
      "type": "cargo",
      "subcommand": "clean",
      "problemMatcher": [
        "$rustc"
      ],
      "group": "clean",
      "label": "Rust: cargo clean"
    },
    {
      "type": "cargo",
      "subcommand": "build",
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build",
      "label": "Rust: cargo build"
    }
  ]
}
