{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'tx_engine'",
      "cargo": {
        "args": [
          "build",
          "--bin=tx_engine",
          "--package=tx_engine"
        ],
        "filter": {
          "name": "tx_engine",
          "kind": "bin"
        }
      },
      "args": [
        "./assets/sample_input.csv"
      ],
      "cwd": "${workspaceFolder}",
      "terminal": "console"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests in executable 'tx_engine'",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--bin=tx_engine",
          "--package=tx_engine"
        ],
        "filter": {
          "name": "tx_engine",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ]
}
